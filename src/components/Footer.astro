---
const today = new Date()
---

<footer>
  <p>&copy; {today.getFullYear()} Pintar Blog. Hak cipta dilindungi.</p>
</footer>

<style>
  footer {
    margin-block-start: var(--space-fluid-xl);
    padding-block: var(--space-fluid-l);
    padding-inline: var(--space-2);
    background: linear-gradient(var(--bg-wash), transparent) 0 0 / 100% 400px
      no-repeat;
    color: var(--text-secondary);
    text-align: center;
  }

  footer p {
    margin: 0;
    max-inline-size: none;
    font-size: var(--font-caption);
  }
</style>
