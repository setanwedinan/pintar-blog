---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Header from '../components/Header.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts'

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  )
  return paginate(posts, { pageSize: 24 })
}

const { page } = Astro.props
const posts = page.data
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead
      title={`Pintar AI Blog | ${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Blog',
        name: 'Pintar AI Blog',
        alternateName: 'Blog Pintar',
        description: SITE_DESCRIPTION,
        url: Astro.site.href,
        inLanguage: 'id',
        publisher: {
          '@type': 'Organization',
          name: 'Pintar',
          url: Astro.site.href,
        },
      })}
    />
    <style>
      main {
        inline-size: min(100%, 1000px);
        padding-inline: var(--gutter);
      }
      .hero {
        margin-block-end: var(--space-fluid-l);
        padding-block: var(--space-4);
        text-align: center;
      }
      .hero h1 {
        margin-block: 0 1rem;
        font-size: clamp(2rem, 1.719rem + 1.25vw, 2.5rem);
        line-height: 1.2;
        letter-spacing: -0.02em;
      }
      .hero p {
        max-inline-size: 600px;
        margin-block: 0;
        margin-inline: auto;
        color: var(--text-secondary);
        font-size: clamp(1rem, 0.93rem + 0.3125vw, 1.125rem);
        line-height: 1.6;
      }
      .post-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
        gap: var(--gutter);
        margin: 0;
        padding: 0;
        list-style: none;
      }
      /* Whole card clickable through the title link's ::after overlay */
      .post-card {
        position: relative;
        margin: 0;
        overflow: clip;
        background: var(--bg-elevated);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        transition:
          box-shadow 0.2s var(--ease-out),
          border-color 0.2s var(--ease-out);
      }
      .post-card:has(.card-link:focus-visible) {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .card-link {
        color: inherit;
        background: none;
      }
      .card-link::after {
        content: '';
        position: absolute;
        inset: 0;
      }
      .card-link:focus-visible {
        outline: 2px solid transparent;
      }
      .post-image {
        display: block;
        inline-size: 100%;
        block-size: 200px;
        object-fit: cover;
        background: var(--bg-secondary);
        border-radius: 0;
      }
      .post-image-placeholder {
        block-size: 8px;
        background: var(--accent);
        opacity: 0.6;
      }
      .post-content {
        padding: var(--space-3);
      }
      .post-title {
        margin-block: 0 0.5rem;
        color: var(--text-primary);
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.4;
        letter-spacing: -0.01em;
      }
      .post-description {
        display: -webkit-box;
        margin-block: 0 0.75rem;
        overflow: hidden;
        color: var(--text-secondary);
        font-size: 0.9375rem;
        line-height: 1.6;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
      }
      .post-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding-block-start: 0.75rem;
        border-block-start: 1px solid var(--border-color);
      }
      .post-date {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
      }
      .post-tag {
        padding-block: 0.125rem;
        padding-inline: 0.5rem;
        background: var(--tag-bg);
        border-radius: 100px;
        color: var(--accent);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.01em;
      }
      .post-card:active {
        scale: 0.98;
      }
      @media (hover: hover) and (pointer: fine) {
        .post-card:hover {
          border-color: var(--accent);
          box-shadow: var(--shadow-elevated);
        }
        .post-card:hover .post-title {
          color: var(--accent-dark);
        }
      }
      @media (prefers-reduced-motion: no-preference) {
        .post-card {
          transition:
            box-shadow 0.2s var(--ease-out),
            border-color 0.2s var(--ease-out),
            transform 0.2s var(--ease-out),
            scale 0.15s var(--ease-out);
        }
        @media (hover: hover) and (pointer: fine) {
          .post-card:hover {
            transform: translateY(-2px);
          }
        }
      }
      .pager {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-block-start: var(--space-6);
        color: var(--text-secondary);
        font-size: var(--font-caption);
      }
      .pager a {
        padding-block: 0.75rem;
        font-weight: 700;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="hero">
        <h1>&#128221; Blog Pintar</h1>
        <p>Coding, teknologi, dan random thoughts seputar kehidupan digital.</p>
      </div>
      <ul class="post-grid">
        {
          posts.map(post => (
            <li class="post-card">
              {post.data.heroImage ? (
                <Image
                  width={640}
                  height={320}
                  src={post.data.heroImage}
                  alt=""
                  class="post-image"
                />
              ) : (
                <div class="post-image-placeholder" aria-hidden="true" />
              )}
              <div class="post-content">
                <h2 class="post-title">
                  <a class="card-link" href={`/blog/${post.id}/`}>
                    {post.data.title}
                  </a>
                </h2>
                <p class="post-description">{post.data.description}</p>
                <div class="post-meta">
                  <p class="post-date">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="post-tags">
                      {post.data.tags
                        .filter(t => t !== 'Daily Update')
                        .slice(0, 2)
                        .map(tag => (
                          <span class="post-tag">{tag}</span>
                        ))}
                    </div>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
      <nav class="pager" aria-label="Halaman">
        {
          page.url.prev ? (
            <a href={page.url.prev}>&larr; Lebih baru</a>
          ) : (
            <span />
          )
        }
        <span>Halaman {page.currentPage} dari {page.lastPage}</span>
        {
          page.url.next ? (
            <a href={page.url.next}>Lebih lama &rarr;</a>
          ) : (
            <span />
          )
        }
      </nav>
    </main>
    <Footer />
  </body>
</html>
